{
  "name": "benchmarks-golang-cnn-benchmark",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "benchmarks/golang/cnn-benchmark",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx-go/nx-go:build",
      "options": {
        "main": "{projectRoot}/cnn_benchmark/main.go",
        "outputPath": "{projectRoot}/dist/server"
      }
    },
    "serve": {
      "executor": "@nx-go/nx-go:serve",
      "options": {
        "main": "{projectRoot}/cnn_benchmark/main.go"
      }
    },
    "test": {
      "executor": "@nx-go/nx-go:test"
    },
    "lint": {
      "executor": "@nx-go/nx-go:lint"
    },
    "tidy": {
      "executor": "@nx-go/nx-go:tidy"
    },
    "image": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "docker build -t fabiocaffarello/go-cnn-benchmark:latest .",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "production": {
          "env": {
            "ASSUME_NO_MOVING_GC_UNSAFE_RISK_IT_WITH": "go1.22"
          }
        }
      }
    }
  }
}
